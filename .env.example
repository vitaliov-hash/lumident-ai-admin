# Скопируйте в .env и вставьте ключ только в локальный файл.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
PORT=3000
# Для LumiDent Pro: постоянная внешняя PostgreSQL-база.
# Без DATABASE_URL запускается прежний прототип, данные которого не сохраняются.
DATABASE_URL=
